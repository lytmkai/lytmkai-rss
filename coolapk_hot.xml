4%，realme 0.5%）&lt;br&gt;5.荣耀 —— 13.2%&lt;br&gt;6.苹果 —— 12.7%&lt;br&gt;&lt;br&gt;2026 W36：大盘下降约10%&lt;br&gt;1.华为 —— 20.3%&lt;br&gt;2.OPPO —— 16.2%（含一加 3%，realme 0.6%）&lt;br&gt;3.vivo —— 16.1%（含iQOO 4%）&lt;br&gt;4.小米 —— 14.5%&lt;br&gt;5.荣耀 —— 14.4%&lt;br&gt;6.苹果 —— 13.7%&lt;br&gt;&lt;br&gt;2026 W35：大盘下降约10%&lt;br&gt;1.华为 —— 19.6%&lt;br&gt;2.vivo —— 16.5%（含iQOO 4.5%）&lt;!--break--&gt;&lt;br&gt;3.OPPO —— 16.3%（含一加 3.3%，realme 0.5%）&lt;br&gt;4.小米 —— 14.7%&lt;br&gt;5.苹果 —— 14.7%&lt;br&gt;6.荣耀 —— 14.0%&lt;br&gt;&lt;br&gt;2026 W34：大盘变化不大&lt;br&gt;1.华为 —— 20.2%&lt;br&gt;2.vivo —— 16.3%（含iQOO 4.5%）&lt;br&gt;3.OPPO —— 16.2%（含一加 3.3%，realme 0.5%）&lt;br&gt;4.小米 —— 15.1%&lt;br&gt;5.苹果 —— 14.6%&lt;br&gt;6.荣耀 —— 13.7%&lt;br&gt;&lt;br&gt;&lt;a class=&quot;feed-link-tag&quot; href=&quot;https://www.coolapk.com/t/%E4%BB%8A%E6%97%A5%E7%83%AD%E7%82%B9?type=0&quot;&gt;#今日热点#&lt;/a&gt; &lt;a class=&quot;feed-link-tag&quot; href=&quot;https://www.coolapk.com/t/%E9%B8%BF%E8%92%997?type=0&quot;&gt;#鸿蒙7#&lt;/a&gt; &lt;a class=&quot;feed-link-tag&quot; href=&quot;https://www.coolapk.com/t/%E5%8D%8E%E4%B8%BAPuraXView?type=0&quot;&gt;#华为PuraXView#&lt;/a&gt;&lt;/p&gt;&lt;img src=&quot;http://10.0.0.1:50108/coolapk_img/4781500ce8a16b4e97ceb2efa724c837.jpg&quot; &gt;</description><link>https://www.coolapk.com/feed/73826081</link><guid isPermaLink="false">https://www.coolapk.com/feed/73826081</guid><pubDate>Fri, 18 Sep 2026 04:02:15 GMT</pubDate><author>竹本青</author></item><item><title>首发已经到货，有啥问题直接问[受虐滑稽] 我可以拿16pm做做对比#iPhone18Pro系列首发上手# #数码日常# #iPhone18#</title><description>&lt;p&gt;首发已经到货，有啥问题直接问[受虐滑稽] 我可以拿16pm做做对比&lt;a class=&quot;feed-link-tag&quot; href=&quot;https://www.coolapk.com/t/iPhone18Pro%E7%B3%BB%E5%88%97%E9%A6%96%E5%8F%91%E4%B8%8A%E6%89%8B?type=0&quot;&gt;#iPhone18Pro系列首发上手#&lt;/a&gt; &lt;a class=&quot;feed-link-tag&quot; href=&quot;https://www.coolapk.com/t/%E6%95%B0%E7%A0%81%E6%97%A5%E5%B8%B8?type=0&quot;&gt;#数码日常#&lt;/a&gt; &lt;a class=&quot;feed-link-tag&quot; href=&quot;https://w