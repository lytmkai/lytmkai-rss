%BB%8A%E6%97%A5%E7%83%AD%E7%82%B9?type=0&quot;&gt;#今日热点#&lt;/a&gt; &lt;a class=&quot;feed-link-tag&quot; href=&quot;https://www.coolapk.com/t/iQOOZ11S?type=0&quot;&gt;#iQOOZ11S#&lt;/a&gt; &lt;a class=&quot;feed-link-tag&quot; href=&quot;https://www.coolapk.com/t/OriginOS6?type=0&quot;&gt;#OriginOS6#&lt;/a&gt;&lt;/p&gt;&lt;img src=&quot;http://10.0.0.1:50108/coolapk_img/00d5cfd84174469cd77ffe9dad4dcb01.jpg&quot; &gt;&lt;img src=&quot;http://10.0.0.1:50108/coolapk_img/1ff25835f0fff0df1e9f3f81eb3c0d64.jpg&quot; &gt;&lt;img src=&quot;http://10.0.0.1:50108/coolapk_img/e46c40e424b5745519df7721785026f2.jpg&quot; &gt;</description><link>https://www.coolapk.com/feed/73312036</link><guid isPermaLink="false">https://www.coolapk.com/feed/73312036</guid><pubDate>Tue, 18 Aug 2026 11:57:07 GMT</pubDate><author>竹本青</author></item><item><title>【iQOO Neo11 至尊版发布：天玑9500M，首销3399元起】- 12GB+256GB —— 首销 3399元- 16GB+256GB —— 首销 3799元- 12GB+512GB —— 首销 3999元- 16GB+512GB ...</title><description>&lt;p&gt;【iQOO Neo11 至尊版发布：天玑9500M，首销3399元起】&lt;br&gt;&lt;br&gt;- 12GB+256GB —— 首销 3399元&lt;br&gt;- 16GB+256GB —— 首销 3799元&lt;br&gt;- 12GB+512GB —— 首销 3999元&lt;br&gt;- 16GB+512GB —— 首销 4399元&lt;br&gt;&lt;br&gt;◇ 外观&lt;br&gt;- 乘风丨疾影黑丨驰光白&lt;br&gt;- 大R角设计丨横置 DECO&lt;br&gt;- 金属机身丨AG微磨砂哑光后盖&lt;br&gt;- 约8.6mm丨225g&lt;br&gt;&lt;br&gt;◇ 性能&lt;br&gt;- 天玑9500M移动平台&lt;br&gt;- 自研电竞芯片 Q2&lt;br&gt;- LPDDR5X Ultra丨UFS 4.1&lt;br&gt;- 新一代 Monster 超核引擎&lt;br&gt;- 8K 冰穹散热系统&lt;br&gt;&lt;br&gt;◇ 显示&lt;br&gt;- 6.83英寸2K屏幕丨维信诺 F2 发光材料&lt;br&gt;- 1000nits 手动最高亮度丨2000nit 全屏峰值亮度&lt;br&gt;- 500Hz 多指触控采样率丨4000Hz 瞬时触控采样率&lt;!--break--&gt;&lt;br&gt;- 圆偏振光 2.0 | 1nit 暗夜护眼&lt;br&gt;&lt;br&gt;◇ 电池&lt;br&gt;- 9100mAh 蓝海大电池&lt;br&gt;- 100W有线快充&lt;br&gt;- 全局直驱供电2.0&lt;br&gt;&lt;br&gt;◇ 影像&lt;br&gt;- 前置丨1600万像素镜头&lt;br&gt;- 主摄丨5000万像素索尼1/1.56型主摄&lt;br&gt;- 超广角丨800万像素超广角镜头&lt;br&gt;&lt;br&gt;◇ 其他&lt;br&gt;- 对称立体双扬丨X 轴马达&lt;br&gt;- 超声波 3D 指纹丨多功能 NFC丨红外遥控&lt;br&gt;- IP68&amp;amp;69 防尘防水&lt;br&gt;- 寰宇电竞 Wi-Fi 三芯片丨iQOO 15 Ultra 同款超感触控芯片&lt;br&gt;&lt;br&gt;&lt;a class=&quot;feed-link-tag&quot; href=&quot;https://www.coolapk.com/t/%E4%BB%8A%E6%97%A5%E7%83%AD%E7%82%B9?type=0&quot;&gt;#今日热点#&lt;/a&gt;&lt;/p&gt;&lt;img src=&quot;http://10.0.0.1:50108/coolapk_img/0ddceef8de4d66f217cba853ee522997.jpg&quot; &gt;&lt;img src=&quot;http://10.0.0.1:50108/coolapk_img/d558b24077526a08e3043ae435c8ddda.jpg&quot; &gt;&lt;img src=&quot;http://10.0.0.1:50108/coolapk_img/7c20e63266bf3e5bd901a9d1fe3a4455.jpg&quot; &gt;&lt;img src=&quot;http://10.0.0.1:50108/coolapk_img/85cbc2c3457b763a6ddc59981b13cbae.jpg&quot; &gt;&lt;img src=&quot;http://10.0.0.1:50108/coolapk_img/3dfe0f5c9f41379d5cb1b3aaa6ce219f.jpg&quot; &gt;&lt;img src=&quot;http://10.0.0.1:50108/coolapk_img/16bf30b2d04d23d764595882005b6f86.jpg&quot; &gt;&lt;img src=&quot;http://10.0.0.1:50108/coolapk_img/aadd0a3f1b7332dfbdbd67c016bf1c48.jpg&quot; &gt;&lt;img src=&quot;http://10.0.0.1:50108/coolapk_img/c56a583bbefefb0ccd98d1f28d1722be.jpg&quot; &gt;&lt;img src=&quot;http://10.0.0.1:50108/coolapk_img/78844a843c8d748769b310e64e1eda5b.jpg&quot; &gt;</description><link>https://www.coolapk.com/feed/73311738</link><guid isPermaLink="false">https://www.coolapk.com/feed/73311738</guid><pubDate>Tue, 18 Aug 2026 11:38:57 GMT</pubDate><author>赛博帕鲁</author></item><item><title>【卢伟冰：小米新一代玄戒芯片即将发布】 8月18日，小米集团合伙人卢伟冰在财报电话会上透露，去年小米成功推出的玄戒O1芯片，在三款终端上的累计出货量已超过百...</title><description>&lt;p&gt;【卢伟冰：小米新一代玄戒芯片即将发布】

8月18日，小米集团合伙人卢伟冰在财报电话会上透露，去年小米成功推出的玄戒O1芯片，在三款终端上的累计出货量已超过百万，实现了旗舰芯片规模化验证，全新一代小米玄戒芯片也即将发布。

&lt;a class=&quot;feed-link-tag&quot; href=&quot;https://www.coolapk.com/t/%E4%BB%8A%E6%97%A5%E7%83%AD%E7%82%B9?type=0&quot;&gt;#今日热点#&lt;/a&gt; &lt;a class=&quot;feed-link-tag&quot; href=&quot;https://www.coolapk.com/t/%E7%8E%84%E6%88%92?type=0&quot;&gt;#玄戒#&lt;/a&gt; &lt;a class=&quot;feed-link-tag&quot; href=&quot;https://www.coolapk.com/t/HyperOS4?type=0&quot;&gt;#HyperOS4#&lt;/a&gt;&lt;/p&gt;&lt;img src=&quot;http://10.0.0.1:50108/coolapk_img/3dcf4b2a775cba7c6cadf66fc6f2687f.jpg&quot; &gt;&lt;img src=&quot;http://10.0.0.1:50108/coolapk_img/93f5147c0268fcd75147db31cbca07e9.jpg&quot; &gt;</description><link>https://www.coolapk.com/feed/73311632</link><guid isPermaLink="false">https://www.coolapk.com/feed/73311632</guid><pubDate>Tue, 18 Aug 2026 11:31:57 GMT</pubDate><author>竹本青</author></item><item><title>【奔驰新一代C级车全球首发：S级同款发光格栅】奔驰表示，自1982年问世以来，C级车累计销量突破1200万辆。新一代C级车，迎来史上最全面技术升级。◇ 颜值- 首度...</title><description>&lt;p&gt;【奔驰新一代C级车全球首发：S级同款发光格栅】&lt;br&gt;&lt;br&gt;奔驰表示，自1982年问世以来，C级车累计销量突破1200万辆。新一代C级车，迎来史上最全面技术升级。&lt;br&gt;&lt;br&gt;◇ 颜值&lt;br&gt;- 首度搭载S级同款发光格栅&lt;br&gt;- 星徽头灯与尾灯前后呼应&lt;br&gt;- 智能数字大灯光线照射更精准通透&lt;br&gt;- 打开车门，外后视镜投射的三叉星徽点亮地面&lt;br&gt;- 座舱延续C级车一贯的运动精致感&lt;br&gt;- Burmester 3D环绕立体声音响系统支持杜比全景声，配备15个扬声器&lt;br&gt;- 全新多功能方向盘&lt;br&gt;&lt;br&gt;◇ 智能&lt;br&gt;- 基于奔驰自研MB.OS架构，并以持续迭代的OTA，让智能体验贴近中国用户日常需求&lt;br&gt;- 将豆包AI大模型等前沿能力融入智能座舱&lt;br&gt;- 携手Momenta共同研发中国专属的城区及高速领航辅助驾驶系统，已实现“全国都能开”&lt;br&gt;- 未来在中国上市时，将搭载Momenta R7“世界模型”&lt;br&gt;&lt;br&gt;◇ 驾控&lt;br&gt;- 新款2.0升M 254 EVO四缸汽油发动机&lt;!--break--&gt;，搭载第二代智能电机系统，可提供最高17千瓦额外功率及205牛·米额外扭矩&lt;br&gt;- 48伏电气系统支持滑行与能量回收&lt;br&gt;- 全新电动辅助增压器可在毫秒级迅速增压&lt;br&gt;- 专属优化悬挂系统&lt;br&gt;&lt;br&gt;&lt;a class=&quot;feed-link-tag&quot; href=&quot;https://www.coolapk.com/t/%E4%BB%8A%E6%97%A5%E7%83%AD%E7%82%B9?type=0&quot;&gt;#今日热点#&lt;/a&gt; &lt;a class=&quot;feed-link-tag&quot; href=&quot;https://www.coolapk.com/t/%E6%B1%BD%E8%BD%A6?type=0&quot;&gt;#汽车#&lt;/a&gt; &lt;a class=&quot;feed-link-tag&quot; href=&quot;https://www.coolapk.com/t/%E5%A5%94%E9%A9%B0?type=0&quot;&gt;#奔驰#&lt;/a&gt;&lt;/p&gt;&lt;img src=&quot;http://10.0.0.1:50108/coolapk_img/d5f4a2946668db22277df2094f4d05c3.jpg&quot; &gt;&lt;img src=&quot;http://10.0.0.1:50108/coolapk_img/1c2be4711f1934266683336dccf3e8df.jpg&quot; &gt;&lt;img src=&quot;http://10.0.0.1:50108/coolapk_img/5da705783b636519521d5a32de68fac9.jpg&quot; &gt;&lt;img src=&quot;http://10.0.0.1:50108/coolapk_img/3a7f9b73840a46a29079a1c53762a015.jpg&quot; &gt;&lt;img src=&quot;http://10.0.0.1:50108/coolapk_img/9f3bafe940dbd71ea6875d0eb99338fe.jpg&quot; &gt;&lt;img src=&quot;http://10.0.0.1:50108/coolapk_img/be24e4af8ae8b7c03f46bb81cc166fcc.jpg&quot; &gt;</description><link>https://www.coolapk.com/feed/73306423</link><guid isPermaLink="false">https://www.coolapk.com/feed/73306423</guid><pubDate>Tue, 18 Aug 2026 06:06:59 GMT</pubDate><author>赛博帕鲁</author></item><item><title>完了，捅错洞了。[黑线] 刚才换卡，捅错了，捅进去了。 图上标的那个洞，是干啥作用的？ 怎么测试有没有捅坏？[喝酒] 真是醉了。 设计师真坏，明摆着就是让你捅...</title><description>&lt;p&gt;完了，捅错洞了。[黑线]

